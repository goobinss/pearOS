{
  "name": "pear-os",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "pnpm --dir apps/web dev",
    "build": "pnpm --dir apps/web build",
    "start": "pnpm --dir apps/web start",
    "typecheck": "pnpm --dir apps/web typecheck",
    "test": "pnpm --dir apps/web test && pnpm --dir packages/sdk test",
    "lint": "eslint apps/web packages examples && node scripts/check-boundary.mjs"
  },
  "devDependencies": {
    "eslint": "10.11.0",
    "eslint-config-next": "16.3.8"
  }
}
